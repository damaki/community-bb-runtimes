name = "$(profile_underscored)_$(target)"
description = "$(profile) runtime for the $(pretty_target) SoC"
version = "$(version)"

long-description = """
## Usage

First edit your `alire.toml` file and add the following elements:
 - Add `$(profile_underscored)_$(target)` in the dependency list:
   ```toml
   [[depends-on]]
   $(profile_underscored)_$(target) = "*"
   ```
 - if applicable, apply any runtime configuration variables (see below).

Then edit your project file to add the following elements:
 - "with" the run-time project files. With this, gprbuild will compile the run-time before your application
   ```ada
$(project_file_withs)
   ```
 - Specify the `Target` and `Runtime` attributes:
   ```ada
      for Target use runtime_build'Target;
      for Runtime ("Ada") use runtime_build'Runtime ("Ada");
   ```
 - specify the `Linker` switches:
   ```ada
   package Linker is
     for Switches ("Ada") use Runtime_Build.Linker_Switches;
   end Linker;
   ```

The runtime is configurable via Alire crate configuration variables.
See the project website for full details of the available options.

This runtime crate supports the whole STM32F4 family, one MCU sub-family at
a time. By default, the runtime is configured for the STM32F411 sub-family,
targeting the STM32F411CEU6 (48-pin, 512KB flash -- e.g. the "WeAct
BlackPill" board). If you are using a different MCU, then you will need to
configure the runtime by adding the following to your `alire.toml`. For
example, to configure the runtime for the STM32F411RCT6 (64-pin, 256KB
flash):
```toml
[configuration.values]
$(profile_underscored)_$(target).MCU_Sub_Family         = "F411"
$(profile_underscored)_$(target).MCU_Pin_Count          = "R"
$(profile_underscored)_$(target).MCU_Flash_Memory_Size  = "C"
```

By default, the runtime configures the clock tree for a 100 MHz system clock
from the high-speed internal (HSI) oscillator, using the PLL. If you want a
different clock configuration, then use the crate configuration variables to
specify the configuration you wish to use. For example, to configure the
runtime to generate a 100 MHz system clock from a 25 MHz HSE crystal
oscillator (matching many F411 boards, including the "WeAct BlackPill"):
```toml
[configuration.values]
# Configure a 25 MHz HSE crystal oscillator
$(profile_underscored)_$(target).HSE_Clock_Frequency = 25000000
$(profile_underscored)_$(target).HSE_Bypass = false

# Select the PLL as the SYSCLK source, driven from HSE
$(profile_underscored)_$(target).SYSCLK_Src = "PLL"
$(profile_underscored)_$(target).PLL_Src = "HSE"

# Configure the PLL VCO to run at 400 MHz from the 25 MHz HSE
# (fVCO = fHSE * (N/M) = 25 MHz * (400/25) = 400 MHz)
$(profile_underscored)_$(target).PLL_M_Div = 25
$(profile_underscored)_$(target).PLL_N_Mul = 400

# Configure the PLL P output (SYSCLK) to run at 100 MHz from the 400 MHz VCO
$(profile_underscored)_$(target).PLL_P_Div = "DIV4"

# Configure the PLL Q output (used by USB OTG FS / SDIO / RNG, must be
# <= 48 MHz) to run at 40 MHz from the 400 MHz VCO
$(profile_underscored)_$(target).PLL_Q_Div = 10

# Configure the AHB, APB1 and APB2 prescalers
$(profile_underscored)_$(target).AHB_Pre  = "DIV1"
$(profile_underscored)_$(target).APB1_Pre = "DIV2"
$(profile_underscored)_$(target).APB2_Pre = "DIV1"
```

The runtime will generate a compile time error when an invalid PLL
configuration is set, or when the APB1/APB2 frequency limits (50 MHz / 100
MHz) are exceeded.

The interrupt stack size is also configurable:
```toml
[configuration.values]
$(profile_underscored)_$(target).Interrupt_Stack_Size = 1024
```
"""

authors = ["AdaCore", "Daniel King"]
maintainers = ["Daniel King <damaki.gh@gmail.com>"]
maintainers-logins = ["damaki"]
licenses = "GPL-3.0-or-later WITH GCC-exception-3.1"
tags = ["embedded", "runtime", "stm32f4", "stm32f411"]
website = "https://github.com/damaki/community-bb-runtimes"

project-files = $(project_files_list)

[configuration]
generate_c = false
output_dir = "gnat_user"

[configuration.variables]
MCU_Sub_Family = { type = "Enum", values = ["F411"], default = "F411" }
MCU_Pin_Count = { type = "Enum", values = ["C", "R", "V"], default = "C" }
MCU_Flash_Memory_Size = { type = "String", default = "E" }

LSI_Enabled = { type = "Boolean", default = true }
LSE_Enabled = { type = "Boolean", default = false }
LSE_Bypass = { type = "Boolean", default = false }
HSE_Bypass = { type = "Boolean", default = false }
HSE_Clock_Frequency = { type = "Integer", first = 4000000, last = 26000000, default = 25000000 }
PLL_Src = { type = "Enum", values = ["HSI", "HSE"], default = "HSI" }
PLL_M_Div = { type = "Integer", first = 2, last = 63, default = 8 }
PLL_N_Mul = { type = "Integer", first = 50, last = 432, default = 100 }
PLL_P_Div = { type = "Enum", values = ["DIV2", "DIV4", "DIV6", "DIV8"], default = "DIV2" }
PLL_Q_Div = { type = "Integer", first = 2, last = 15, default = 5 }
SYSCLK_Src = { type = "Enum", values = ["HSI", "HSE", "PLL"], default = "PLL" }
AHB_Pre = { type = "Enum", values = ["DIV1", "DIV2", "DIV4", "DIV8", "DIV16", "DIV64", "DIV128", "DIV256", "DIV512"], default = "DIV1" }
APB1_Pre = { type = "Enum", values = ["DIV1", "DIV2", "DIV4", "DIV8", "DIV16"], default = "DIV2" }
APB2_Pre = { type = "Enum", values = ["DIV1", "DIV2", "DIV4", "DIV8", "DIV16"], default = "DIV1" }

Interrupt_Stack_Size = { type = "Integer", first = 1, default = 1024 }

[[depends-on]]
gnat_arm_elf = "^16"
