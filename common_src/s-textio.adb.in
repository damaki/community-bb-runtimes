--  Minimal version of Text_IO body that selects between different backends

with System.Semihosting;
with System.Segger_RTT_IO;
with $(RUNTIME_CONFIG_PACKAGE);

package body System.Text_IO is

   ----------------
   -- Initialize --
   ----------------

   procedure Initialize is
   begin
      Initialized := True;

      case $(RUNTIME_CONFIG_PACKAGE).Text_IO is
         when $(RUNTIME_CONFIG_PACKAGE).None =>
            null;

         when $(RUNTIME_CONFIG_PACKAGE).Semihosting =>
            null;

         when $(RUNTIME_CONFIG_PACKAGE).Segger_RTT =>
            System.Segger_RTT_IO.Initialize;
      end case;
   end Initialize;

   -----------------
   -- Is_Tx_Ready --
   -----------------

   function Is_Tx_Ready return Boolean is
     (case $(RUNTIME_CONFIG_PACKAGE).Text_IO is
        when $(RUNTIME_CONFIG_PACKAGE).None        => True,
        when $(RUNTIME_CONFIG_PACKAGE).Semihosting => True,
        when $(RUNTIME_CONFIG_PACKAGE).Segger_RTT  =>
          System.Segger_RTT_IO.Is_Tx_Ready);

   -----------------
   -- Is_Rx_Ready --
   -----------------

   function Is_Rx_Ready return Boolean is
     (case $(RUNTIME_CONFIG_PACKAGE).Text_IO is
        when $(RUNTIME_CONFIG_PACKAGE).None        => False,
        when $(RUNTIME_CONFIG_PACKAGE).Semihosting => True,
        when $(RUNTIME_CONFIG_PACKAGE).Segger_RTT  =>
          System.Segger_RTT_IO.Is_Rx_Ready);

   ---------
   -- Get --
   ---------

   function Get return Character is
      Item : Character;
   begin
      case $(RUNTIME_CONFIG_PACKAGE).Text_IO is
         when $(RUNTIME_CONFIG_PACKAGE).None =>
            Item := Character'Val (0);

         when $(RUNTIME_CONFIG_PACKAGE).Semihosting =>
            System.Semihosting.Get (Item);

         when $(RUNTIME_CONFIG_PACKAGE).Segger_RTT =>
            Item := System.Segger_RTT_IO.Get;
      end case;

      return Item;
   end Get;

   ---------
   -- Put --
   ---------

   procedure Put (C : Character) is
   begin
      case $(RUNTIME_CONFIG_PACKAGE).Text_IO is
         when $(RUNTIME_CONFIG_PACKAGE).None =>
            null;

         when $(RUNTIME_CONFIG_PACKAGE).Semihosting =>
            System.Semihosting.Put (C);

         when $(RUNTIME_CONFIG_PACKAGE).Segger_RTT =>
            System.Segger_RTT_IO.Put (C);
      end case;
   end Put;

   ----------------------------
   -- Use_Cr_Lf_For_New_Line --
   ----------------------------

   function Use_Cr_Lf_For_New_Line return Boolean is (True);

end System.Text_IO;
